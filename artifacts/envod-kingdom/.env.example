# Example variable NAMES only. Copy to .env.local (git-ignored) and fill in locally.
# Never commit real values. In production, set these in Vercel → Settings → Environment Variables.

# DataForSEO (private SEO dashboard — server-side only, never exposed to the browser)
# Login = your DataForSEO account email; Password = the API password from
# https://app.dataforseo.com/api-access (NOT your account login password).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional hard monthly cap for dashboard-initiated paid requests, in USD (default 5).
DATAFORSEO_MONTHLY_BUDGET_USD=5
