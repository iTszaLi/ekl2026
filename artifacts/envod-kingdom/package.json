{
  "name": "@workspace/envod-kingdom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build --config vite.config.ts && vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist/server && node prerender.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:counters": "node scripts/check-counter-prerender.mjs",
    "test:image-dimensions": "node scripts/check-image-dimensions.mjs",
    "test:service-catalog": "tsx --test server/service-catalog.test.ts",
    "test:search-console": "tsx --test server/search-console/search-console.test.ts",
    "test:enquiries": "tsx --test server/enquiries.test.ts",
    "test:vercel-enquiries": "tsx --test server/vercel-enquiry-handler.test.ts",
    "indexnow:submit": "node scripts/submit-indexnow.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-select": "^2.1.7",
