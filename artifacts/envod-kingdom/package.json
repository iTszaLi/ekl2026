    "@types/d3-geo": "^3.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "country-flag-icons": "^1.6.20",
    "d3-geo": "^3.1.1",
    "framer-motion": "catalog:",
    "lucide-react": "catalog:",
    "pino-pretty": "^13.2.0",
    "react": "catalog:",
